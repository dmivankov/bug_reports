load("@rules_java//toolchains:default_java_toolchain.bzl", "default_java_toolchain", "DEFAULT_TOOLCHAIN_CONFIGURATION")

default_java_toolchain(
    name = "java-21-fixed-toolchain",
    source_version = "21",
    target_version = "21",
    configuration = DEFAULT_TOOLCHAIN_CONFIGURATION,
    java_runtime = "@rules_java//toolchains:remotejdk_21",
    javabuilder = ":JavaBuilder_deploy_fixed.jar",
)

default_java_toolchain(
    name = "java-21-buggy-toolchain",
    source_version = "21",
    target_version = "21",
    configuration = DEFAULT_TOOLCHAIN_CONFIGURATION,
    java_runtime = "@rules_java//toolchains:remotejdk_21",
    javabuilder = ":JavaBuilder_deploy_buggy.jar",
)

platform(
    name = "remote",
    exec_properties = {
        "OSFamily": "linux",
        "container-image": "docker://ghcr.io/catthehacker/ubuntu:act-22.04@sha256:5f9c35c25db1d51a8ddaae5c0ba8d3c163c5e9a4a6cc97acd409ac7eae239448",
    },
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)


java_library(
    name = "lib",
    srcs = ["Lib.java"],
)

java_test(
    name = "javatest",
    srcs = ["Test.java"],
    test_class = "com.cognite.Test",
    deps = ["lib"],
)
